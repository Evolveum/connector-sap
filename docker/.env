# midPoint server image version (evolveum/midpoint tag)
MP_VER=4.10.3

# PostgreSQL major version (the -alpine variant is used)
PG_VER=17

# Host port the midPoint GUI/REST is published on (container is always 8080).
# Kept off the default 8080 so this rig can coexist with other test stacks.
MP_PORT=11080
